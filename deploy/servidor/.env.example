# .env do servidor de testes. Gere com: deploy/servidor/gerar-env.sh https://<site>.netlify.app
# Valores "gerar" viram segredos aleatórios; "preencher" você completa à mão.

# Endereço do front no Netlify (sem barra no fim)
SITE_URL=preencher

# Banco
SPRING_DATASOURCE_DATABASE=citogenetica
SPRING_DATASOURCE_USERNAME=citogenetica
SPRING_DATASOURCE_PASSWORD=gerar

# Fotos (RustFS, só na rede interna)
STORAGE_REGION=us-east-1
STORAGE_PATH_STYLE=true
STORAGE_BUCKET=citogenetica
STORAGE_ACCESS_KEY=gerar
STORAGE_SECRET_KEY=gerar

# E-mail real pelo Gmail (senha de app: myaccount.google.com/apppasswords)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=preencher
SPRING_MAIL_PASSWORD=preencher
SPRING_MAIL_AUTH=true
SPRING_MAIL_STARTTLS_ENABLE=true
# O Gmail só aceita como remetente a própria conta (ou um alias dela)
API_EMAIL_FROM=preencher

# Segurança
API_SECURITY_RECOVERY_HMAC_SECRET=gerar
API_SECURITY_SESSION_COOKIE_SECURE=true
SPRING_PROFILES_ACTIVE=servidor

# Links usados nos e-mails e origem aceita pela API (derivados de SITE_URL pelo gerador)
API_FRONTEND_URL=${SITE_URL}
API_FRONTEND_EMAIL_CONFIRMATION_URL=${SITE_URL}/confirmar-email
API_FRONTEND_EMAIL_CHANGE_CONFIRMATION_URL=${SITE_URL}/confirmar-troca-email
API_FRONTEND_LABORATORY_INVITATION_URL=${SITE_URL}/convites/aceitar
API_FRONTEND_LABORATORY_ORIENTATION_INVITATION_URL=${SITE_URL}/orientacoes/convites/aceitar
API_CORS_ALLOWED_ORIGINS=${SITE_URL}

# Netlify: token pessoal (User settings > Applications) e Site ID (Site configuration > General)
NETLIFY_AUTH_TOKEN=preencher
NETLIFY_SITE_ID=preencher

# Backups: pasta no PC, quantos manter e hora (UTC) do backup diário
BACKUP_DIR=./backups
BACKUP_MANTER=14
BACKUP_HORA=06
