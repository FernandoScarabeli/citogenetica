# Server Configuration
SERVER_PORT=8080

# Database Configuration
POSTGRES_VERSION=16
SPRING_DATASOURCE_HOST=localhost
SPRING_DATASOURCE_PORT=5432
SPRING_DATASOURCE_DATABASE=citogenetica
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=troque-isto

# Spring Mail Configuration (Mailpit no ambiente local)
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=desenvolvimento
SPRING_MAIL_PASSWORD=troque-isto
SPRING_MAIL_AUTH=false
SPRING_MAIL_STARTTLS_ENABLE=false

# API Security Configuration
API_SECURITY_TOKEN_RECOVERY_EXPIRATION_MINUTES=15
API_SECURITY_RECOVERY_HMAC_SECRET=troque-isto
API_SECURITY_RECOVERY_MAX_ATTEMPTS=5
API_SECURITY_RECOVERY_EMAIL_EXECUTOR_CORE_SIZE=1
API_SECURITY_RECOVERY_EMAIL_EXECUTOR_MAX_SIZE=2
API_SECURITY_RECOVERY_EMAIL_EXECUTOR_QUEUE_CAPACITY=50
# Regex dos endereços dos proxies confiáveis do Tomcat; vazio ignora cabeçalhos encaminhados.
API_SECURITY_TRUSTED_PROXY_REGEX=
API_SECURITY_SESSION_TIMEOUT=30m
# O perfil dev permite HTTP local; mantenha Secure=true fora do ambiente local.
API_SECURITY_SESSION_COOKIE_SECURE=false
API_SECURITY_RATE_LIMIT_WINDOW_MINUTES=15
API_SECURITY_RATE_LIMIT_CLEANUP_INTERVAL_MS=3600000
API_SECURITY_RATE_LIMIT_LOGIN_IP=60
API_SECURITY_RATE_LIMIT_LOGIN_EMAIL=10
API_SECURITY_RATE_LIMIT_RECOVERY_REQUEST_IP=30
API_SECURITY_RATE_LIMIT_RECOVERY_REQUEST_EMAIL=3
API_SECURITY_RATE_LIMIT_VALIDATE_IP=30
API_SECURITY_RATE_LIMIT_VALIDATE_EMAIL=10
API_SECURITY_RATE_LIMIT_RESET_IP=30
API_SECURITY_RATE_LIMIT_RESET_EMAIL=10
# Notificações em tempo real (SSE): conexões simultâneas por usuário e duração de cada uma.
API_SSE_MAX_CONNECTIONS_PER_USER=5
API_SSE_TIMEOUT=30m

# API Configuration
API_FRONTEND_URL=http://localhost:5173
API_CORS_ALLOWED_ORIGINS=http://localhost:5173
API_EMAIL_FROM=no-reply@example.invalid

# Object Storage Configuration
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9090
STORAGE_INTERNAL_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_PATH_STYLE=true
STORAGE_BUCKET=citogenetica
STORAGE_ACCESS_KEY=troque-isto
STORAGE_SECRET_KEY=troque-isto
STORAGE_PRESIGNED_URL_VALIDITY_SECONDS=900

# Mailpit Web UI
MAILPIT_WEB_PORT=8025

# Spring Profile
SPRING_PROFILES_ACTIVE=dev
