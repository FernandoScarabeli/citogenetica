# Server Configuration
SERVER_PORT=8080

# Database Configuration
POSTGRES_VERSION=16
SPRING_DATASOURCE_HOST=localhost
SPRING_DATASOURCE_PORT=5432
SPRING_DATASOURCE_DATABASE=citogenetica
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=troque-isto

# Spring Mail Configuration (Mailpit no ambiente local)
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=desenvolvimento
SPRING_MAIL_PASSWORD=troque-isto
SPRING_MAIL_AUTH=false
SPRING_MAIL_STARTTLS_ENABLE=false

# API Security Configuration
API_SECURITY_JWT_SECRET=troque-isto
API_SECURITY_TOKEN_RECOVERY_EXPIRATION_MINUTES=15

# API Configuration
API_FRONTEND_URL=http://localhost:3000
API_EMAIL_FROM=no-reply@example.invalid

# Object Storage Configuration
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9090
STORAGE_INTERNAL_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_PATH_STYLE=true
STORAGE_BUCKET=citogenetica
STORAGE_ACCESS_KEY=troque-isto
STORAGE_SECRET_KEY=troque-isto
STORAGE_PRESIGNED_URL_VALIDITY_SECONDS=900

# Mailpit Web UI
MAILPIT_WEB_PORT=8025

# Spring Profile
SPRING_PROFILES_ACTIVE=dev
